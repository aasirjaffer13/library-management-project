{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Compile Java",
            "type": "shell",
            "command": "javac",
            "args": [
                "-d", "build",
                "-cp", "lib/h2-2.2.224.jar",
                "--release", "21",
                "${workspaceFolder}/src/**/*.java"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": ["$java"]
        }
    ]
}
